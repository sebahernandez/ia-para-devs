---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllPostsForAdmin } from '../../lib/admin-posts';

const PAGE_SIZE = 20;

const allPosts = await listAllPostsForAdmin();
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isFinite(requestedPage) ? Math.min(Math.max(1, requestedPage), totalPages) : 1;

const posts = allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const dateFormatter = new Intl.DateTimeFormat('es-CL', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<AdminLayout title="Posts">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-white">Posts ({allPosts.length})</h1>
    <a
      href="/admin/posts/new/"
      class="rounded-md bg-white px-4 py-2 text-sm font-medium text-ink-950"
    >
      Nuevo post
    </a>
  </div>

  <table class="mt-8 w-full text-sm">
    <thead>
      <tr class="border-b border-ink-800 text-left text-xs uppercase tracking-widest text-ink-400">
        <th class="py-2 pr-4">Título</th>
        <th class="py-2 pr-4">Categoría</th>
        <th class="py-2 pr-4">Fecha</th>
        <th class="py-2 pr-4">Estado</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      {
        posts.map((p) => (
          <tr class="border-b border-ink-900" data-post-row={p.id}>
            <td class="py-3 pr-4 text-ink-100">{p.title}</td>
            <td class="py-3 pr-4 text-ink-400">{p.categorySlug}</td>
            <td class="py-3 pr-4 text-ink-400">{dateFormatter.format(p.pubDate)}</td>
            <td class="py-3 pr-4">
              {p.draft ? (
                <span class="chip">Borrador</span>
              ) : (
                <span class="chip">Publicado</span>
              )}
              {p.featured && <span class="chip ml-1">Destacado</span>}
            </td>
            <td class="py-3 text-right">
              <a href={`/admin/posts/${p.id}/edit/`} class="link mr-3">
                Editar
              </a>
              <button type="button" class="link delete-btn" data-id={p.id}>
                Eliminar
              </button>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    totalPages > 1 && (
      <div class="mt-6 flex items-center justify-between text-sm">
        <a
          href={page > 1 ? `/admin/?page=${page - 1}` : undefined}
          aria-disabled={page <= 1}
          class={`link ${page <= 1 ? 'pointer-events-none opacity-30' : ''}`}
        >
          ← Anterior
        </a>
        <span class="text-ink-400">Página {page} de {totalPages}</span>
        <a
          href={page < totalPages ? `/admin/?page=${page + 1}` : undefined}
          aria-disabled={page >= totalPages}
          class={`link ${page >= totalPages ? 'pointer-events-none opacity-30' : ''}`}
        >
          Siguiente →
        </a>
      </div>
    )
  }

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este post? Esta acción no se puede deshacer.')) return;
        const id = btn.dataset.id;
        const res = await fetch(`/api/admin/posts/${id}`, { method: 'DELETE' });
        if (res.ok) {
          btn.closest('tr')?.remove();
        } else {
          alert('No se pudo eliminar el post.');
        }
      });
    });
  </script>
</AdminLayout>
