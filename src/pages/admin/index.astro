---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllPostsForAdmin } from '../../lib/admin-posts';

const PAGE_SIZE = 20;

const allPosts = await listAllPostsForAdmin();
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isFinite(requestedPage) ? Math.min(Math.max(1, requestedPage), totalPages) : 1;

const posts = allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const dateFormatter = new Intl.DateTimeFormat('es-CL', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<AdminLayout title="Posts">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold">Posts ({allPosts.length})</h1>
    <a
      href="/admin/posts/new/"
      class="theme-cta rounded-md px-4 py-2 text-sm font-medium"
    >
      Nuevo post
    </a>
  </div>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-ink-700 text-left text-xs uppercase tracking-widest text-ink-400">
          <th class="py-2.5 pr-4 font-medium">Título</th>
          <th class="whitespace-nowrap py-2.5 pr-4 font-medium">Categoría</th>
          <th class="whitespace-nowrap py-2.5 pr-4 font-medium">Fecha</th>
          <th class="py-2.5 pr-4 font-medium">Estado</th>
          <th class="py-2.5 pl-4 text-right font-medium">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {
          posts.map((p) => (
            <tr class="border-b border-ink-800 align-middle" data-post-row={p.id}>
              <td class="py-3 pr-4 text-ink-100">{p.title}</td>
              <td class="whitespace-nowrap py-3 pr-4 text-ink-400">{p.categorySlug}</td>
              <td class="whitespace-nowrap py-3 pr-4 text-ink-400">{dateFormatter.format(p.pubDate)}</td>
              <td class="py-3 pr-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip">{p.draft ? 'Borrador' : 'Publicado'}</span>
                  <button
                    type="button"
                    class="chip feature-btn"
                    data-id={p.id}
                    data-featured={p.featured ? 'true' : 'false'}
                  >
                    {p.featured ? '★ Destacado' : '☆ Destacar'}
                  </button>
                </div>
              </td>
              <td class="whitespace-nowrap py-3 pl-4 text-right">
                <a href={`/admin/posts/${p.id}/edit/`} class="link">
                  Editar
                </a>
                <button type="button" class="link delete-btn ml-3" data-id={p.id}>
                  Eliminar
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    totalPages > 1 && (
      <div class="mt-6 flex items-center justify-between text-sm">
        <a
          href={page > 1 ? `/admin/?page=${page - 1}` : undefined}
          aria-disabled={page <= 1}
          class={`link ${page <= 1 ? 'pointer-events-none opacity-30' : ''}`}
        >
          ← Anterior
        </a>
        <span class="text-ink-400">Página {page} de {totalPages}</span>
        <a
          href={page < totalPages ? `/admin/?page=${page + 1}` : undefined}
          aria-disabled={page >= totalPages}
          class={`link ${page >= totalPages ? 'pointer-events-none opacity-30' : ''}`}
        >
          Siguiente →
        </a>
      </div>
    )
  }

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este post? Esta acción no se puede deshacer.')) return;
        const id = btn.dataset.id;
        const res = await fetch(`/api/admin/posts/${id}`, { method: 'DELETE' });
        if (res.ok) {
          btn.closest('tr')?.remove();
        } else {
          alert('No se pudo eliminar el post.');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.feature-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const next = btn.dataset.featured !== 'true';
        btn.disabled = true;
        const res = await fetch(`/api/admin/posts/${id}/featured`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ featured: next }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('No se pudo actualizar el destacado.');
          btn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
