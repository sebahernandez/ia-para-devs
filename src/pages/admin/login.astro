---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Iniciar sesión" showNav={false}>
  <div class="mx-auto max-w-sm pt-16">
    <h1 class="text-2xl font-semibold text-white">Panel de administración</h1>
    {error && <p class="mt-4 text-sm text-red-400">Contraseña incorrecta.</p>}
    <form method="POST" action="/api/admin/login" class="mt-6 flex flex-col gap-4">
      <input
        type="password"
        name="password"
        placeholder="Contraseña"
        required
        autofocus
        class="rounded-lg border border-ink-700 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-100
               placeholder-ink-500 focus:border-ink-500 focus:outline-none focus:ring-1 focus:ring-ink-500"
      />
      <button
        type="submit"
        class="rounded-md bg-white px-4 py-2.5 text-sm font-medium text-ink-950
               transition-transform duration-200 hover:-translate-y-0.5"
      >
        Entrar
      </button>
    </form>
  </div>
</AdminLayout>
