---
import { getAllPostsWithContent } from '../../lib/posts';
import PostLayout from '../../layouts/PostLayout.astro';

// SSG: astro genera una página estática por cada post en build-time,
// consultando Neon una sola vez (no una query por slug).
export async function getStaticPaths() {
  const posts = await getAllPostsWithContent();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostLayout post={post}>
  <Fragment set:html={post.contentHtml} />
</PostLayout>